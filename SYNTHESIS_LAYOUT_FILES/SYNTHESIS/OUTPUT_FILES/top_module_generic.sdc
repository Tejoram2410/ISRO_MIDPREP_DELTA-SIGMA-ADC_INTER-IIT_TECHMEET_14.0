set_clock_gating_check -setup 0.0 
set_wire_load_mode "enclosed"
set_dont_use true [get_lib_cells tsl18fs120_scl_ss/slbhb2]
set_dont_use true [get_lib_cells tsl18fs120_scl_ss/slbhb1]
set_dont_use true [get_lib_cells tsl18fs120_scl_ss/slbhb4]
set_clock_latency -source -max -late 1.25 [get_clocks clk_a]
set_clock_latency -source -max -early 1.0 [get_clocks clk_a]
set_clock_latency -source -min -early 1.25 [get_clocks clk_a]
set_clock_latency -source -min -late 0.75 [get_clocks clk_a]
set_clock_uncertainty -setup 5.0 [get_clocks clk_a]
set_clock_uncertainty -hold 5.0 [get_clocks clk_a]
