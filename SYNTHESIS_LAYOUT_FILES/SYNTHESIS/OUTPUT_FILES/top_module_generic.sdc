set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design top_module

create_clock -name "clk_a" -period 200.0 -waveform {0.0 100.0} [get_ports clk_pad]
set_clock_transition -min 25.0 [get_clocks clk_a]
