  [get_ports clk_pad]  \
  [get_ports reset_pad]  \
  [get_ports pcm_data_pad]  \
  [get_ports mode_pad] ] -to [list \
  [get_ports {data_out_pad[19]}]  \
  [get_ports {data_out_pad[18]}]  \
  [get_ports {data_out_pad[17]}]  \
  [get_ports {data_out_pad[16]}]  \
